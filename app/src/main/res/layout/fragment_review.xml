<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="20dp">
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/review_title"
        android:textColor="@color/text" android:textStyle="bold" android:textSize="28sp" />
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/review_subtitle"
        android:layout_marginTop="6dp" android:textSize="13sp" android:textColor="@color/muted" />
    <com.google.android.material.button.MaterialButton xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/btnFilterTrack" style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="12dp"
        android:text="@string/filter_all_tracks" android:maxLines="1" android:ellipsize="end" app:cornerRadius="14dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
        android:background="@drawable/telemetry_card" android:padding="20dp" android:layout_marginTop="24dp">
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
            <TextView style="@style/TelemetryLabel" android:text="@string/total_laps_label" />
            <TextView android:id="@+id/tvTotalLaps" style="@style/TelemetryValue" android:text="@string/zero" />
        </LinearLayout>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="2" android:orientation="vertical">
            <TextView android:id="@+id/tvHistoryBestLabel" style="@style/TelemetryLabel" android:text="@string/best_select_track" />
            <TextView android:id="@+id/tvHistoryBest" style="@style/TelemetryValue" android:text="@string/lap_time_placeholder" android:textColor="@color/accent" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="16dp">
        <TextView style="@style/TelemetryLabel" android:layout_width="0dp" android:layout_weight="1" android:text="@string/history_list_caption" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btnClearHistory" style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content" android:layout_height="48dp" android:text="@string/clear_history" android:textColor="@color/muted" />
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/recyclerLaps" android:layout_width="match_parent" android:layout_height="match_parent" android:clipToPadding="false" android:paddingBottom="12dp" />
        <TextView android:id="@+id/tvEmpty" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center"
            android:text="@string/history_empty" android:lineSpacingExtra="6dp" android:textColor="@color/muted" android:textSize="15sp" />
    </FrameLayout>
</LinearLayout>
