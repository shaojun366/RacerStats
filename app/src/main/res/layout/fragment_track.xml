<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/background" android:orientation="vertical">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/toolbar"
        android:layout_width="match_parent" android:layout_height="56dp"
        app:title="@string/recording" app:titleTextColor="@color/text"
        app:navigationIcon="@drawable/ic_back" app:navigationContentDescription="@string/navigate_back" />
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:fillViewport="true">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="20dp">
            <TextView style="@style/TelemetryLabel" android:text="@string/recording_subtitle" android:layout_marginBottom="16dp" />
            <TextView android:id="@+id/mapStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:minHeight="56dp" android:padding="14dp" android:background="@drawable/telemetry_card"
                android:textColor="@color/accent" android:textSize="12sp" android:lineSpacingExtra="4dp"
                android:clickable="true" android:focusable="true" android:visibility="gone" android:layout_marginBottom="12dp" />
            <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="280dp"
                app:cardCornerRadius="20dp" app:cardElevation="0dp" app:strokeWidth="1dp" app:strokeColor="@color/line">
                <FrameLayout android:layout_width="match_parent" android:layout_height="match_parent">
                    <androidx.fragment.app.FragmentContainerView android:id="@+id/map"
                        android:layout_width="match_parent" android:layout_height="match_parent" />
                    <com.example.racerstats.maps.TrackRouteView android:id="@+id/routePreview"
                        android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone" />
                </FrameLayout>
            </com.google.android.material.card.MaterialCardView>
            <LinearLayout android:id="@+id/statsContainer" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:padding="18dp" android:background="@drawable/telemetry_card" android:layout_marginTop="16dp">
                <TextView android:id="@+id/recordingState" style="@style/TelemetryLabel" android:text="@string/recording_ready" android:textColor="@color/accent" />
                <TextView android:id="@+id/tvDistance" style="@style/TelemetryValue" android:text="@string/track_distance_zero" android:textSize="30sp" />
                <TextView android:id="@+id/tvPointCount" style="@style/TelemetryLabel" android:text="@string/track_points_zero" android:layout_marginTop="6dp" />
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginTop="10dp">
                    <TextView style="@style/TelemetryLabel" android:layout_width="0dp" android:layout_weight="1" android:text="@string/tolerance_label" />
                    <com.google.android.material.button.MaterialButton android:id="@+id/btnTolerance"
                        style="@style/Widget.Material3.Button.TextButton" android:layout_width="wrap_content" android:layout_height="48dp"
                        android:text="@string/tolerance_default" android:minWidth="0dp" android:paddingHorizontal="12dp" />
                </LinearLayout>
            </LinearLayout>
            <TextView android:id="@+id/lineInstructions" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/recording_help" android:layout_marginTop="14dp" android:lineSpacingExtra="4dp" android:textColor="@color/muted" android:textSize="12sp" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
    <LinearLayout android:id="@+id/actionsContainer" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:paddingHorizontal="20dp" android:paddingBottom="8dp" android:background="@color/background">
        <com.google.android.material.button.MaterialButton android:id="@+id/btnStartFinish"
            android:layout_width="match_parent" android:layout_height="56dp" android:text="@string/start_recording" app:cornerRadius="16dp" />
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton android:id="@+id/btnPause"
                style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="52dp" android:text="@string/pause" android:layout_marginEnd="6dp" app:cornerRadius="16dp" />
            <com.google.android.material.button.MaterialButton android:id="@+id/btnSetLine"
                style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="0dp" android:layout_weight="1"
                android:layout_height="52dp" android:text="@string/set_line" app:cornerRadius="16dp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
